<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    
    @media print {
      .no-print { display: none; }
      body { background-color: #fff; color: #000; padding: 0; }
      .container { width: 100%; max-width: 100%; padding: 0; margin: 0; }
    }
  </style>
</head>
<body class="bg-white py-4" onload="window.print()">

  <div class="container">
    <div class="text-center mb-4 border-bottom pb-3">
      <h3 class="text-uppercase fw-bold m-0">LAPORAN STRUKTUR ORGANISASI JABATAN JABATAN</h3>
      <p class="text-muted m-0">Sistem Informasi Manajemen Kepegawaian - Central Panel</p>
      <small class="text-secondary">Waktu Cetak: <%= new Date().toLocaleString('id-ID') %></small>
    </div>

    <div class="mb-3 text-end no-print">
      <button onclick="window.print()" class="btn btn-sm btn-dark">Klik Cetak / Save PDF</button>
      <a href="/jabatan" class="btn btn-sm btn-secondary">Kembali</a>
    </div>

    <table class="table table-bordered border-dark align-middle">
      <thead class="table-light border-dark text-center">
        <tr>
          <th style="width: 5%">No</th>
          <th>Unit Organisasi Kerja</th>
          <th>Posisi Jabatan Struktural</th>
          <th>Nama Pejabat Pegawai</th>
          <th>Tanggal Mulai Menjabat</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-3">Tidak ada data penempatan posisi jabatan yang aktif saat ini.</td>
          </tr>
        <% } else { %>
          <% data.forEach((row, index) => { %>
            <tr>
              <td class="text-center"><%= index + 1 %></td>
              <td><%= row.unit_name %></td>
              <td><strong><%= row.position_title %></strong></td>
              <td><%= row.employee_name %></td>
              <td class="text-center">
                <%= new Date(row.start_date).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>

    <div class="row mt-5 pt-4">
      <div class="col-8"></div>
      <div class="col-4 text-center">
        <p class="m-0">Padang, <%= new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %></p>
        <p class="fw-bold">Diketahui Oleh,</p>
        <br><br><br>
        <p class="text-decoration-underline fw-bold mb-0">Administrator Sistem</p>
        <small class="text-muted">Central Panel Authority</small>
      </div>
    </div>
  </div>

</body>
</html>