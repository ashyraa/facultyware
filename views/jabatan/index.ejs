<div class="space-y-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h2 class="text-2xl font-bold text-black">Daftar Jabatan Aktif Pegawai</h2>
            <p class="text-[#45464d] text-sm">Kelola dan pantau penempatan posisi seluruh pegawai</p>
        </div>
        <div class="flex items-center gap-2">
            <% 
                // ACL Helper untuk kemudahan pengecekan
                const userPerms = (typeof permissions !== 'undefined' && permissions) ? permissions : [];
            %>
            
            <% if (userPerms.includes('tentukan_jabatan')) { %>
                <a href="/penempatan/create" class="bg-black text-white px-5 py-2.5 rounded-lg hover:bg-gray-800 transition-all font-semibold text-sm">
                    + Tempatkan Jabatan Baru
                </a>
            <% } %>

            <% if (userPerms.includes('export_pdf')) { %>
                <a href="/jabatan/export-pdf" class="bg-white border border-[#c6c6cd] text-black px-5 py-2.5 rounded-lg hover:bg-[#f2f4f6] transition-all font-semibold text-sm">
                    Export PDF
                </a>
            <% } %>
        </div>
    </div>

    <form action="/penempatan" method="GET" class="flex gap-2">
        <input type="text" name="search" class="flex-1 px-4 py-2 bg-white border border-[#c6c6cd] rounded-lg focus:ring-2 focus:ring-[#0058be] outline-none" placeholder="Cari nama pegawai atau jabatan..." value="<%= search %>">
        <button type="submit" class="bg-[#0058be] text-white px-6 py-2 rounded-lg font-semibold">Cari</button>
        <% if (search) { %>
            <a href="/penempatan" class="bg-white border border-[#c6c6cd] px-4 py-2 rounded-lg font-semibold text-[#45464d]">Reset</a>
        <% } %>
    </form>

    <section class="bg-white rounded-xl border border-[#c6c6cd] overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-[#f2f4f6]">
                        <th class="px-6 py-4 text-[12px] font-bold text-[#45464d] uppercase tracking-wider">No</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-[#45464d] uppercase tracking-wider">Nama Pegawai</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-[#45464d] uppercase tracking-wider">Jabatan</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-[#45464d] uppercase tracking-wider">Unit Organisasi</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-[#45464d] uppercase tracking-wider">Tanggal Mulai</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-[#45464d] uppercase tracking-wider text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#c6c6cd]">
                    <% if (data && data.length === 0) { %>
                        <tr><td colspan="6" class="px-6 py-10 text-center text-[#45464d]">Tidak ada data ditemukan.</td></tr>
                    <% } else if (data) { %>
                        <% data.forEach((item, index) => { %>
                            <tr class="hover:bg-[#f7f9fb] transition-colors">
                                <td class="px-6 py-4 text-sm text-[#191c1e]"><%= ((currentPage - 1) * 5) + index + 1 %></td>
                                <td class="px-6 py-4 text-sm font-bold text-black"><%= item.employee_name %></td>
                                <td class="px-6 py-4 text-sm text-[#191c1e]"><%= item.position_title %></td>
                                <td class="px-6 py-4 text-sm text-[#191c1e]"><%= item.unit_name %></td>
                                <td class="px-6 py-4 text-sm text-[#191c1e]"><%= new Date(item.start_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %></td>
                                <td class="px-6 py-4 text-right">
                                    <% if (userPerms.includes('view_history')) { %>
                                        <a href="/jabatan/history/<%= item.employee_id %>" class="text-[#0058be] font-bold hover:underline text-sm">Lihat Riwayat</a>
                                    <% } else { %>
                                        <span class="text-gray-400 text-sm italic">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <nav class="flex justify-center mt-6">
            <ul class="flex items-center gap-1">
                <li><a class="px-4 py-2 border rounded-lg <%= currentPage === 1 ? 'bg-gray-100 text-gray-400' : 'bg-white hover:bg-gray-50' %>" href="/penempatan?search=<%= search %>&page=<%= currentPage - 1 %>">Prev</a></li>
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li><a class="px-4 py-2 border rounded-lg <%= currentPage === i ? 'bg-black text-white' : 'bg-white hover:bg-gray-50' %>" href="/penempatan?search=<%= search %>&page=<%= i %>"><%= i %></a></li>
                <% } %>
                <li><a class="px-4 py-2 border rounded-lg <%= currentPage === totalPages ? 'bg-gray-100 text-gray-400' : 'bg-white hover:bg-gray-50' %>" href="/penempatan?search=<%= search %>&page=<%= currentPage + 1 %>">Next</a></li>
            </ul>
        </nav>
    <% } %>
</div>