<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/home">Central Panel</a>
      <span class="navbar-text ms-auto text-white">Halo, <%= user %></span>
      <a href="/logout" class="btn btn-sm btn-danger ms-3">Logout</a>
    </div>
  </nav>

  <div class="container bg-white p-4 rounded shadow-sm">
    <div class="mb-4">
      <a href="/jabatan/penempatan" class="btn btn-sm btn-secondary mb-2">&larr; Kembali ke Daftar</a>
      <h2>Log Riwayat Jabatan Pegawai</h2>
      <h4 class="text-primary"><%= employeeName %></h4>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle">
        <thead class="table-secondary">
          <tr>
            <th style="width: 5%">No</th>
            <th>Jabatan Struktural</th>
            <th>Unit Organisasi</th>
            <th>Tanggal Mulai</th>
            <th>Tanggal Selesai</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (historyData.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-3">Pegawai ini belum memiliki riwayat catatan jabatan.</td>
            </tr>
          <% } else { %>
            <% historyData.forEach((row, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><strong><%= row.position_title %></strong></td>
                <td><%= row.unit_name %></td>
                <td><%= new Date(row.start_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %></td>
                <td>
                  <%= row.end_date ? new Date(row.end_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : '-' %>
                </td>
                <td>
                  <% if (row.end_date === null) { %>
                    <span class="badge bg-success">Aktif Saat Ini</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Sudah Selesai</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>