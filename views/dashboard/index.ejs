<div class="space-y-6">
    <div>
        <h2 class="text-2xl font-bold text-black">Dashboard</h2>
        <p class="text-[#45464d] text-sm">Selamat datang, <%= user %>. Berikut adalah ringkasan sistem kepegawaian hari ini.</p>
    </div>

    <% const userPerms = (typeof permissions !== 'undefined' && permissions) ? permissions : []; %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        
        <div class="bg-white p-6 rounded-xl border border-[#c6c6cd] shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-[#e6f0fa] flex items-center justify-center text-[#0058be]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-[#45464d] uppercase tracking-wide">Total Pegawai</p>
                <h3 class="text-2xl font-bold text-black mt-1"><%= stats.totalPegawai %></h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl border border-[#c6c6cd] shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-gray-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-[#45464d] uppercase tracking-wide">Total Jabatan</p>
                <h3 class="text-2xl font-bold text-black mt-1"><%= stats.totalJabatan %></h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl border border-[#c6c6cd] shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center text-red-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-[#45464d] uppercase tracking-wide">Jabatan Kosong</p>
                <h3 class="text-2xl font-bold text-black mt-1"><%= stats.jabatanKosong %></h3>
            </div>
        </div>

        <% if (userPerms.includes('view_mutasi') || userPerms.includes('tentukan_jabatan')) { %>
            <div class="bg-white p-6 rounded-xl border border-[#c6c6cd] shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
                <div class="w-12 h-12 rounded-full bg-green-50 flex items-center justify-center text-green-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-[#45464d] uppercase tracking-wide">Mutasi Bulan Ini</p>
                    <h3 class="text-2xl font-bold text-black mt-1"><%= stats.mutasiBulanIni %></h3>
                </div>
            </div>
        <% } %>

    </div>

    <div class="mt-8">
        </div>
</div>